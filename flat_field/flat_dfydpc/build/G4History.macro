/run/verbose 0
/control/execute gps_mono.in
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 25 keV
/gps/pos/type Beam
/gps/pos/shape Circle
/gps/pos/sigma_r 5.15453 um
/gps/pos/centre 0 0. -85 cm
/gps/ang/type iso
/gps/ang/maxtheta 0.010 rad
/gps/ang/rot1 -1 0 0
/control/execute detmask_config.in
/Pepi/det/setBidimensional true
/Pepi/det/setSourcePosZ -85 cm
/Pepi/det/setSrcObjDistance 60 cm
/Pepi/det/setObjectDetDistance 60 cm
/Pepi/det/setMaskThickness 100 um
/Pepi/det/setM2Pitch 55 um
/Pepi/det/setM2Aperture 20.0 um
/Pepi/det/setRotAngle 0 deg
/Pepi/det/setAcquisitionType singlemask
/Pepi/det/setDetType 0COL
/Pepi/det/setThreshold1 5.0 keV
/Pepi/det/setThreshold2 0.5 keV
/Pepi/det/setThreshold3 0.5 keV
/Pepi/det/setThreshold4 0.5 keV
/Pepi/det/setThreshold5 0.5 keV
/Pepi/det/setThreshold6 0.5 keV
/Pepi/det/setThreshold7 0.5 keV
/Pepi/det/setThreshold8 0.5 keV
/Pepi/cont/loadConfig geometry_config.in
/Pepi/cont/setBaseName PCI_
/Pepi/cont/setCustomName frame_01
/run/initialize
/Pepi/cont/beamOn 100000000
/run/geometryModified
